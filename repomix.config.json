{
  "output": {
    "style": "markdown",
    "filePath": "repomix-output.md",
    "showLineNumbers": true
  },
  "ignore": {
    "customPatterns": [
      ".git/**",
      ".claude/**",
      ".codex/**",
      ".cursor/**",
      ".idea/**",
      ".nova/**",
      ".vscode/**",
      "node_modules/**",
      "vendor/**",
      "bootstrap/cache/**",
      "public/build/**",
      "public/hot",
      "public/storage/**",
      "storage/**",
      "test-results/**",
      "playwright-report/**",
      "blob-report/**",
      "coverage/**",
      "repomix-output.*",
      "*.log",
      "*.zip",
      "database/*.sqlite"
    ]
  }
}
